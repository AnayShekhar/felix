{
  "manifest_version": 3,
  "name": "Felix",
  "version": "1.0.0",
  "description": "Connect your accounts to Felix so it can act on your behalf.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "identity"
  ],
  "host_permissions": [
    "https://*/*"
  ]
}
