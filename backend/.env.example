# Felix backend configuration.
# FELIX_* settings take precedence; legacy LUMIS_* settings remain supported.
# Copy to .env for local development; in production, set these in the Railway
# service's environment (Variables tab) — a .env file is never deployed.

# ── Required in every environment ───────────────────────────────────────────
# The ONLY AI key. Groq is the sole provider (multimodal model below).
GROQ_API_KEY=your_groq_key_here

# ── Required in production (the server refuses to start on Railway without it)
# Any long random string; signs the session JWTs. Local dev falls back to a
# built-in dev-only secret.
FELIX_JWT_SECRET=generate-a-long-random-string-here

# ── Cloud browser (Browserbase) — required for browser tools + cookie sync ──
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# ── Google OAuth consent flow — required for the google_api tool family ─────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Externally reachable base URL, used to build the OAuth redirect URI.
# Optional: derived from the request (honoring x-forwarded-proto) if unset.
PUBLIC_BASE_URL=

# ── Sign in with Google / Apple (iOS clients) ────────────────────────────────
# Optional audience check for Google ID tokens (iOS client id).
FELIX_GOOGLE_CLIENT_ID=your_google_client_id
# Apple bundle id for Sign in with Apple verification.
FELIX_APPLE_BUNDLE_ID=com.anay.lumis

# ── Optional tuning (sensible defaults) ──────────────────────────────────────
# PORT=8000                  # set automatically by Railway
# GROQ_MODEL=qwen/qwen3.6-27b   # multimodal; llama-4-scout shut down 2026-07-17
# AGENT_MAX_STEPS=20
# AGENT_THINK_TIMEOUT=45
# BROWSER_SESSION_IDLE_S=180
# FELIX_DB_PATH=/app/data/actions.db
# FELIX_MEMORY_PATH=/app/data/memory.json
