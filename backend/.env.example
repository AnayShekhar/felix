# --- Required ---
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Secret for signing account session JWTs (auth.py). Use a long random string.
LUMIS_JWT_SECRET=generate-a-long-random-string-here

# --- Optional: social login ---
LUMIS_APPLE_BUNDLE_ID=com.anay.lumis
LUMIS_GOOGLE_CLIENT_ID=your_google_client_id

# --- Optional: agent tuning ---
AGENT_MAX_STEPS=20
MAC_TOOL_TIMEOUT=30

# --- Optional: runtime / storage ---
PORT=8000
LUMIS_DB_PATH=/app/data/actions.db
LUMIS_MEMORY_PATH=/app/data/memory.json
